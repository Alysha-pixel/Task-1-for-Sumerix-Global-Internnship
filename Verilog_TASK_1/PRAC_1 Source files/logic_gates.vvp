v000002AE233C72D0_0 .net "a", 0 0, v000002AE2338D280_0;  1 drivers
v000002AE233B4AC0_0 .net "b", 0 0, v000002AE2338D320_0;  1 drivers
v000002AE2338D1E0_0 .net "y", 0 0, L_000002AE2338D460;  alias, 1 drivers
    .scope S_000002AE233B4C90;
T_0 ;
    %vpi_call 2 22 "$monitor", $time, " A=%b, B=%b, Y=%b", v000002AE2338D280_0, v000002AE2338D320_0, v000002AE2338D3C0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000002AE2338D280_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000002AE2338D320_0, 0, 1;
    %delay 5, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000002AE2338D280_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000002AE2338D320_0, 0, 1;
    %delay 5, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000002AE2338D280_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000002AE2338D320_0, 0, 1;
    %delay 5, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000002AE2338D280_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000002AE2338D320_0, 0, 1;
    %delay 5, 0;
    %vpi_call 2 31 "$finish" {0 0 0};
    %end;
    .thread T_0;
    .scope S_000002AE233B4C90;
T_1 ;
