S_000002AE233B4C90 .scope module, "stimulus" "stimulus" 2 4;
 .timescale -12 -12;
v000002AE2338D280_0 .var "A", 0 0;
v000002AE2338D320_0 .var "B", 0 0;
v000002AE2338D3C0_0 .net "Y", 0 0, L_000002AE2338D460;  1 drivers
S_000002AE2338D050 .scope module, "xn1" "xnor_gate" 2 16, 3 53 0, S_000002AE233B4C90;
 .timescale -12 -12;
    .port_info 0 /OUTPUT 1 "y";
    .port_info 1 /INPUT 1 "a";
    .port_info 2 /INPUT 1 "b";
L_000002AE233B4B60 .functor XOR 1, v000002AE2338D280_0, v000002AE2338D320_0, C4<0>, C4<0>;
L_000002AE2338D460 .functor NOT 1, L_000002AE233B4B60, C4<0>, C4<0>, C4<0>;
